# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - API GATEWAY (ERP KUDIBA)
# ==============================================================================

# Configurações do Servidor Gateway
GATEWAY_PORT=8080
GATEWAY_ENV=development
GATEWAY_READ_TIMEOUT=15s
GATEWAY_WRITE_TIMEOUT=30s
GATEWAY_IDLE_TIMEOUT=120s
GATEWAY_MAX_BODY_BYTES=10485760 # 10MB

# Segurança e TLS
TLS_ENABLED=false
TLS_CERT_FILE=/etc/kudiba/certs/tls.crt
TLS_KEY_FILE=/etc/kudiba/certs/tls.key
CORS_ALLOWED_ORIGINS=https://app.kudiba.ao,https://admin.kudiba.ao,http://localhost:3000

# Autenticação e Chaves JWKS
AUTH_JWKS_URL=http://core-api:8081/auth/.well-known/jwks.json
AUTH_JWKS_CACHE_TTL=15m
AUTH_JWT_ISSUER=https://auth.kudiba.ao

# Redis Perimétrico (Rate Limiting, Idempotência e Sessões)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=50

# Upstream Services (Rede Interna)
CORE_API_URL=http://localhost:8081
FISCAL_ENGINE_GRPC_TARGET=localhost:9090

# Regulamentação AGT & Decreto Presidencial n.º 71/25
AGT_PLATFORM_URL=https://webservices.agt.minfin.gov.ao/facturacao-electronica
AGT_CONTINGENCY_MAX_DAYS=60
AGT_TIMEOUT_SECONDS=5

# Observabilidade e Telemetria
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=kudiba-api-gateway
LOG_LEVEL=info
LOG_FORMAT=json
